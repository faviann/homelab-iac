[Unit]
Description=Browser device Chrome session
BindsTo=crawler-display.service
After=crawler-display.service crawler-wm.service

[Service]
User={{ browser_device_session_user }}
Environment=DISPLAY=:0
ExecStart=/usr/bin/google-chrome-stable --user-data-dir=/home/{{ browser_device_session_user }}/.config/google-chrome --password-store=basic --start-maximized --no-first-run --no-default-browser-check
Restart=always

# Starting the display, including its automatic restarts, starts this unit again.
[Install]
WantedBy=crawler-display.service
