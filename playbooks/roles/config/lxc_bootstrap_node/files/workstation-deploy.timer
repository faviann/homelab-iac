# Nightly routine deploy of origin/main. It lands interrupting changes only when
# the workstation's busy probe reports idle. `systemctl stop` pauses it; the
# next run against this node starts it again. A missed night is not caught up.
[Unit]
Description=Nightly workstation deploy at origin/main

[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=false
Unit=workstation-deploy@main.service

[Install]
WantedBy=timers.target
