services:
  docker-metadata-proxy:
    image: wollomatic/socket-proxy:1.13.1
    container_name: docker-metadata-proxy
    # The scratch image cannot resolve the host's docker group.
    user: "0:0"
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    command:
      - '-listenip=0.0.0.0'
      - '-allowfrom=0.0.0.0/0'
      # Homepage needs only list and stats. Inspect stays denied because it returns container env.
      - '-allowGET=(/v1\.[0-9]+)?/containers/(json|[a-zA-Z0-9_.-]+/stats)'
    ports:
      - {{ homepage_docker_proxy_port }}:2375
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - admin
{% if lxc_docker_env_hawser_enabled | default(false) %}
  hawser:
    container_name: hawser
    image: ghcr.io/finsys/hawser:latest
    restart: unless-stopped
    ports:
      - 2376:2376
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ dockhand_hawser_stacks_dir }}:{{ dockhand_hawser_stacks_dir }}
    environment:
      - PORT=2376
      - BIND_ADDRESS=0.0.0.0
      - TOKEN=${TOKEN}
      - DOCKER_SOCKET=/var/run/docker.sock
      - STACKS_DIR={{ dockhand_hawser_stacks_dir }}
      - AGENT_NAME={{ inventory_hostname }}
      - LOG_LEVEL=info
    networks:
      - admin
{% endif %}
networks:
  admin:
    driver: bridge
