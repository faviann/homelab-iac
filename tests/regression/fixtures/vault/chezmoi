#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
with Path(os.environ["VAULT_TEST_BOUNDARY_CAPTURE"]).open(
    "a", encoding="utf-8"
) as stream:
    stream.write(
        json.dumps({"boundary": "chezmoi", "command": args[:1], "targets": args[1:]})
        + "\n"
    )
if os.environ.get("VAULT_TEST_CHEZMOI_FAIL") == "1":
    raise SystemExit(1)
if args[:1] != ["apply"] or len(args) != 2:
    raise SystemExit(90)
# The dotfiles template regenerates the live passphrase file from Bitwarden.
item = json.loads(
    Path(os.environ["VAULT_TEST_BW_ITEM_STATE"]).read_text(encoding="utf-8")
)
target = Path(args[1])
target.write_text(item["notes"] + "\n", encoding="utf-8")
target.chmod(0o600)
raise SystemExit(0)
