---
extends: default
ignore: |
  archive/
  .ansible/
  collections/
  stacks/auth/auth/appdata/authentik/blueprints/
  stacks/auth/auth/compose.yaml
  stacks/public/immich/compose.yaml
rules:
  line-length:
    max: 140
    level: warning
    # Renovate digest pins (image: ...@sha256:...) are one unbreakable token.
    allow-non-breakable-inline-mappings: true
  # The settings below are required by ansible-lint for a compatible
  # custom yamllint config (enables `ansible-lint --fix`).
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
