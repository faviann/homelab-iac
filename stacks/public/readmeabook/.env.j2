{%- set readmeabook_credentials = {
  'jwt_secret': stack_vars.jwt_secret | mandatory,
  'jwt_refresh_secret': stack_vars.jwt_refresh_secret | mandatory,
  'config_encryption_key': stack_vars.config_encryption_key | mandatory,
  'postgres_password': stack_vars.postgres_password | mandatory
} -%}
{%- for credential_name, credential_value in readmeabook_credentials.items() -%}
{%- if credential_value is not string
  or credential_value | trim | length == 0
  or credential_value | trim == 'REPLACE_ME' -%}
{{ undef('ReadMeABook requires a configured ' ~ credential_name) }}
{%- endif -%}
{%- endfor -%}
PUID={{ docker_uid }}
PGID={{ docker_gid }}
TZ=America/Montreal
HOMEPAGE_FQDN={{ stack_name }}.{{ default_domain }}
UMASK=002
LOG_LEVEL=info
JWT_SECRET={{ readmeabook_credentials.jwt_secret | replace('$', '$$') }}
JWT_REFRESH_SECRET={{ readmeabook_credentials.jwt_refresh_secret | replace('$', '$$') }}
CONFIG_ENCRYPTION_KEY={{ readmeabook_credentials.config_encryption_key | replace('$', '$$') }}
POSTGRES_PASSWORD={{ readmeabook_credentials.postgres_password | replace('$', '$$') }}
DISABLE_LOCAL_LOGIN=true
