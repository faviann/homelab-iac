PUID={{ docker_uid }}
PGID={{ docker_gid }}
TZ=America/Montreal
HOMEPAGE_FQDN={{ stack_name }}.{{ default_domain }}
UMASK=002
LOG_LEVEL=info
JWT_SECRET={{ stack_vars.jwt_secret | compose_env }}
JWT_REFRESH_SECRET={{ stack_vars.jwt_refresh_secret | compose_env }}
CONFIG_ENCRYPTION_KEY={{ stack_vars.config_encryption_key | compose_env }}
POSTGRES_PASSWORD={{ stack_vars.postgres_password | compose_env }}
DISABLE_LOCAL_LOGIN=true
