# Compose cannot see inside a bind-mounted file. A changed config.yaml on its
# own therefore never recreates the container, and the running process keeps
# serving the previous configuration while the host file looks current.
#
# This fingerprint of the rendered config changes whenever the config changes,
# for a template edit or a rotated secret alike. Compose sees the changed
# environment value, recreates the service, and the new config takes effect.
CLIPROXY_CONFIG_FINGERPRINT={{ lookup('template', (item.source_path | dirname) ~ '/appdata/config/config.yaml.j2') | hash('sha256') }}
